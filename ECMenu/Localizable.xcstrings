    },
    "alert.visibility.hide.all.named": {
      "comment": "The named selected item could not be hidden",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t hide “%@” because it isn’t writable."
