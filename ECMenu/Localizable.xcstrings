{
  "sourceLanguage": "en",
  "strings": {
    "alert.command.confirm": {
      "comment": "Dismisses a context-command error alert",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "alert.command.title": {
      "comment": "Title shared by context-command error alerts",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation Couldn’t Be Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.all.counted": {
      "comment": "All processed images have date-attribute problems",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The images were compressed, but the date attributes of %lld images couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已压缩但遇到问题：%lld 张图片的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.all.named": {
      "comment": "The named image was compressed, but its dates could not be updated",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was compressed, but its date attributes couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已压缩但遇到问题：“%@”的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.partial.counted": {
      "comment": "Some processed images have date-attribute problems",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images were compressed, but the date attributes of %lld images couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图片已压缩但遇到问题：%lld 张图片的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.fileDates.partial.named": {
      "comment": "The named image has a date-attribute problem while other images completed normally",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images were compressed, but the date attributes of “%@” couldn’t be updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图片已压缩但遇到问题：“%@”的时间属性写入失败。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.all.counted": {
      "comment": "No selected images could be compressed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t compress the selected images because %lld images aren’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩图片：%lld 张图片没有写入权限。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.all.named": {
      "comment": "The named image could not be compressed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t compress “%@” because it isn’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩图片：“%@”没有写入权限。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.partial.counted": {
      "comment": "Some selected images could not be compressed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images couldn’t be compressed because %lld images aren’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩部分图片：%lld 张图片没有写入权限。"
          }
        }
      }
    },
    "alert.imageCompression.writePermission.partial.named": {
      "comment": "The named image could not be compressed while other images succeeded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images couldn’t be compressed because “%@” isn’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法压缩部分图片：“%@”没有写入权限。"
          }
        }
      }
    },
    "alert.newTextFile.writePermission.named": {
      "comment": "A TXT file could not be created in the named directory",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create a TXT file because “%@” isn’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法新建 TXT：“%@”没有写入权限。"
          }
        }
      }
    },
    "alert.openInApplication.failed": {
      "comment": "A selected item could not be opened in the named application",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open in %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法进入 %@。"
          }
        }
      }
    },
    "alert.visibility.hide.all.counted": {
      "comment": "No selected items could be hidden",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t hide the selected items because %lld items aren’t writable."
