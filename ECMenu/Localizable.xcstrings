      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items couldn’t be hidden because “%@” isn’t writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法隐藏部分项目：“%@”没有写入权限。"
